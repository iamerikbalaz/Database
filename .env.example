# Application
APP_ENV=development
APP_NAME=REAWOTE Internal
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=reawote
POSTGRES_USER=reawote
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://reawote:local-development-only@db:5432/reawote

# NAS and worker
NAS_ROOT_PATH=//SERVER/SHARE/MATERIALS
WORKER_TEMP_PATH=C:/REAWOTE_TEMP
IMAGEMAGICK_PATH=
ZIP_EXECUTABLE_PATH=

# Notion
NOTION_API_TOKEN=
NOTION_COMPANIES_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=

# Google Cloud Storage
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=