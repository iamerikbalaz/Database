# Application
APP_ENV=development
APP_NAME=REAWOTE Internal
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Authentication: Secure cookies by default in every APP_ENV.
# Localhost HTTP only: explicitly set both AUTH_COOKIE_SECURE=false and
# AUTH_ALLOW_INSECURE_COOKIE=true; every CORS origin must be localhost, 127.0.0.1,
# or ::1, and APP_ENV must be development/test/demo/e2e. LAN/VPN requires HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_INSECURE_COOKIE=false
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_ABSOLUTE_TIMEOUT_HOURS=8
# Must be at most half the idle timeout (seconds versus minutes).
AUTH_LAST_SEEN_UPDATE_SECONDS=60
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# PostgreSQL
POSTGRES_DB=reawote
POSTGRES_USER=reawote
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://reawote:local-development-only@db:5432/reawote

# NAS and worker
NAS_ROOT_PATH=//SERVER/SHARE/MATERIALS
WORKER_BASE_URL=http://worker:8080
WORKER_TIMEOUT_SECONDS=2
ZIP_POLICY_TIMEZONE=Europe/Prague
PACKAGING_ENABLED=false
PACKAGING_BASE_URL=http://packaging:8081
PACKAGING_SERVICE_TOKEN=
PACKAGING_TIMEOUT_SECONDS=3630
SOURCE_MUTATIONS_ENABLED=false
WORKER_MUTATION_TOKEN=
IDENTITY_JOURNAL_ROOT=
MATERIALS_ROOT=/materials
WORKER_TEMP_PATH=C:/REAWOTE_TEMP
IMAGEMAGICK_PATH=
ZIP_EXECUTABLE_PATH=

# Notion: explicit company comparison only (see docs/notion-reader-plan.md)
NOTION_ENABLED=false
# Separate integration credential; inject securely, never commit a value.
NOTION_ACCESS_TOKEN=
# Data-source UUID, not the containing database UUID.
NOTION_COMPANY_DATA_SOURCE_ID=
# JSON object: local field -> stable Notion property ID. Name/title is mandatory.
NOTION_COMPANY_PROPERTIES={}
NOTION_TIMEOUT_SECONDS=20

# Google Cloud Storage
GCS_ENABLED=false
GCS_BUCKET_NAME=
# Explicit staging prefix; the adapter adds an isolated upload-job UUID.
GCS_STAGING_PREFIX=
# Short-lived OAuth token via secure environment injection; never commit a value.
GCS_ACCESS_TOKEN=
GCS_TIMEOUT_SECONDS=900
# Reserved for a future ADC provider; not consumed by the current token provider.
GOOGLE_APPLICATION_CREDENTIALS=
