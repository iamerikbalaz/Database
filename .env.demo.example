# Isolated local demo configuration. Every value is fictitious and non-secret.
COMPOSE_PROJECT_NAME=reawote-demo
APP_ENV=demo
APP_NAME=REAWOTE Internal Demo

# Host ports are deliberately different from the regular development defaults.
BACKEND_PORT=127.0.0.1:18000
FRONTEND_PORT=127.0.0.1:15173
WORKER_PORT=18080
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# Dedicated demo-only PostgreSQL credentials and database.
POSTGRES_DB=reawote_demo
POSTGRES_USER=reawote_demo
POSTGRES_PASSWORD=demo-only-not-a-secret

# Internal container addresses and paths only. No NAS path is used.
WORKER_BASE_URL=http://worker:8080
WORKER_TIMEOUT_SECONDS=5
MATERIALS_ROOT=/demo-materials
WORKER_POLL_INTERVAL_SECONDS=30

# External integrations are intentionally disabled for the demo.
NOTION_API_TOKEN=
NOTION_COMPANIES_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
