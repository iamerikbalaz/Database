{
  "name": "reawote-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/test-demo-e2e.ps1",
    "test:e2e:guard": "node e2e/direct-invocation.guard.test.mjs",
    "test:e2e:infrastructure": "node --experimental-strip-types --test e2e/*.test.ts",
    "test:e2e:helpers": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/test-demo-e2e-helpers.ps1",
    "test:e2e:list": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/list-demo-e2e-tests.ps1"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  }
}
